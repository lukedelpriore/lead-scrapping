# Del Priore Hospitality Lead Engine, environment example.
# In the cloud these come from the environment configuration dialog.
# Locally copy this file to .env.local and fill it in. Never commit a real .env.

# Database. PostgreSQL 16.
DATABASE_URL=postgresql://dph:dph@localhost:5432/dph_lead_engine

# Auth.js
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=http://localhost:3000
ALLOWED_EMAILS=luke@delpriorehospitality.com,hashir@delpriorehospitality.com
GOOGLE_OAUTH_CLIENT_ID=           # optional in dev, password login is seeded as fallback
GOOGLE_OAUTH_CLIENT_SECRET=
SEED_PASSWORD=                    # optional, seed generates and prints one if blank

# RocketReach
ROCKETREACH_API_KEY=

# AI mode. off = rules based classifier and adjudicator, no Anthropic key needed. on = Claude does both.
AI_MODE=off
ANTHROPIC_API_KEY=                # only required when AI_MODE=on

# Discovery
SERPER_API_KEY=

# Google Sheets service account
GOOGLE_SERVICE_ACCOUNT_B64=       # the service account JSON, base64 encoded on one line (cloud)
GOOGLE_SERVICE_ACCOUNT_JSON=      # or a file path (local only)
SHEET_ID=

# Email over Brevo HTTPS API
BREVO_API_KEY=
MAIL_FROM="Del Priore Lead Engine <leads@delpriorehospitality.com>"

# Reveal safety. Stays off for the entire build.
REVEAL_MODE=off                   # off | ask | auto

# Places, off by default
PLACES_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Ops
LOG_LEVEL=info
TZ=America/New_York
