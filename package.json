{
  "name": "dph-lead-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dph/web dev",
    "worker": "pnpm --filter @dph/worker start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @dph/db generate",
    "db:migrate": "dotenv -e .env.local -- pnpm --filter @dph/db migrate",
    "db:seed": "dotenv -e .env.local -- pnpm --filter @dph/db seed",
    "db:reset": "dotenv -e .env.local -- pnpm --filter @dph/db reset",
    "db:migrate:dev": "dotenv -e .env.local -- pnpm --filter @dph/db migrate:dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "dotenv-cli": "^7.4.4",
    "@types/node": "^22.10.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
