# Live keys for the local Docker stack.
#
# Copy this file to docker/live.env and fill in your keys, then rebuild:
#
#   cp docker/live.env.example docker/live.env
#   docker compose -f docker/compose.local.yml up --build
#
# docker/live.env is gitignored and is never committed or baked into the image,
# so your keys stay on this machine. Do not put real keys in this example file.

# Discovery. Finds businesses and their websites. This is the free part.
# Get a key at serper.dev.
SERPER_API_KEY=

# RocketReach. Finding the owner name by company and person search is free.
# A verified owner cell is a person lookup and costs one credit, and only runs
# when you click Verify and REVEAL_MODE below is not off.
ROCKETREACH_API_KEY=

# Reveal safety.
#   off  = never spend a credit. Verify writes example contacts. Use for testing.
#   ask  = Verify does a real lookup and spends one credit per verified cell.
#   auto = reveal automatically. Use with care.
# Start at off to see the free business and owner lists, then switch to ask
# when you are ready to spend credits on verified cells.
REVEAL_MODE=off

# Optional. Google Places improves coverage for some business types. It costs
# per search. Leave off unless you want it.
PLACES_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Optional. Email over Brevo, for sending lead lists and notifications.
BREVO_API_KEY=

# Optional. Google Sheets export. The service account JSON, base64 encoded on
# one line, plus the target spreadsheet id.
GOOGLE_SERVICE_ACCOUNT_B64=
SHEET_ID=
